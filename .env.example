# =====================================================================
# trading-ai-platform - environment configuration
# Copy to .env (repo root) for local use. NEVER commit .env.
# On Render, set these in the service's Environment tab instead.
# Generate secrets with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# =====================================================================

# ---------- Trading mode (safe defaults - do not change without the live checklist) ----------
TRADING_MODE=PAPER                    # PAPER | DEMO | LIVE
ENABLE_LIVE_TRADING=false             # LIVE also requires the next line, typed exactly
LIVE_TRADING_CONFIRMATION=            # I_UNDERSTAND_LIVE_TRADING_RISKS
ENVIRONMENT=development               # development | production
LOG_LEVEL=INFO

# ---------- Security ----------
EA_API_KEY_ID=                        # public id the EA sends (e.g. ea-cfi-01)
EA_HMAC_SECRET=                       # shared secret for EA request signatures (>= 32 random chars)
API_KEY=                              # dashboard admin key (>= 32 random chars)
JWT_SECRET=                           # dashboard session signing key (>= 32 random chars)
JWT_TTL_MINUTES=60
SIGNATURE_MAX_SKEW_SECONDS=30
RATE_LIMIT_PER_MINUTE=240
RATE_LIMIT_AUTH_PER_MINUTE=10
CORS_ORIGINS=http://localhost:5173    # comma-separated; add your Render dashboard URL

# ---------- Storage ----------
# Local: leave empty for SQLite (./trading_dev.db) or use docker-compose Postgres:
# DATABASE_URL=postgresql://trading:localdev@localhost:5432/trading
DATABASE_URL=
REDIS_URL=
MODELS_DIR=
MODEL_VERSION=                        # pin a model version; empty = registry's ACTIVE model

# ---------- Broker symbols (exact names from YOUR MT5 Market Watch - never assumed) ----------
XAUUSD_SYMBOL=
OIL_SYMBOL=
US30_SYMBOL=
EXTRA_SYMBOLS=                        # LOGICAL=BROKER,... (optional)
# MT5 login details are entered in the MT5 terminal only; listed here for documentation.
CFI_SERVER=
MT5_LOGIN=
MT5_PASSWORD=                         # not used by the backend - never put it in Git

# ---------- Risk limits (fractions of equity) ----------
RISK_PER_TRADE=0.005
MAX_DAILY_LOSS=0.02
MAX_DRAWDOWN=0.08
MAX_SYMBOL_RISK=0.015
MAX_STRATEGY_RISK=0.02
MAX_PORTFOLIO_RISK=0.03
MAX_MARGIN_USAGE=0.40
MAX_POSITIONS=15                      # secondary limit - open RISK below is the real cap
MAX_POSITIONS_PER_SYMBOL=5
LOSS_STREAK_REDUCE_AFTER=2            # after 2 losers in a row: trade at reduced size...
LOSS_STREAK_RISK_SCALE=0.5            # ...half size, until the next winner (never larger)
LOSS_STREAK_COOLDOWN_AFTER=3          # after 3 losers in a row: pause new trades...
LOSS_STREAK_COOLDOWN_MINUTES=120      # ...for 2 hours
MAX_CORRELATED_EXPOSURE=0.02
CORRELATION_THRESHOLD=0.6
RISK_MULTIPLIER_MIN=0.75
RISK_MULTIPLIER_MAX=1.25
EQUITY_SCALING_STEPS=1.0:1.0,1.25:1.05,1.5:1.10,2.0:1.20
INITIAL_EQUITY=100
EMERGENCY_CLOSE_POLICY=KEEP_POSITIONS # KEEP_POSITIONS | CLOSE_ALL

# ---------- Execution ----------
MAX_SPREAD_POINTS=0
MAX_SPREAD_ATR_RATIO=0.15
MAX_SLIPPAGE_POINTS=50
SIGNAL_TTL_SECONDS=60
HEARTBEAT_TIMEOUT_SECONDS=90
PAPER_COMMISSION_PER_LOT=0
PAPER_SLIPPAGE_POINTS=2

# ---------- Trade management ----------
SL_ATR_MULTIPLIER=1.5
TP1_R=1.0
TP2_R=2.0
TP1_CLOSE_FRACTION=0.5
BE_TRIGGER_R=1.0
BE_OFFSET_R=0.05
TIGHTEN_TRIGGER_R=0.8
TIGHTEN_TO_R=-0.5
TRAIL_START_R=1.0
TRAIL_ATR_MULTIPLIER=1.0

# ---------- Signals / model ----------
CONFIDENCE_THRESHOLD=0.60
MIN_PROBABILITY_EDGE=0.15
MAX_HOLD_PROBABILITY=0.50
ALLOW_RULE_BASED_FALLBACK=true        # PAPER/DEMO when no validated model exists
ALLOW_RULE_BASED_IN_LIVE=false
ALLOW_SYDNEY_SESSION=false

# ---------- News (authenticated provider required; no data => SAFE MODE) ----------
NEWS_PROVIDER=none                    # none | fmp | finnhub | tradingeconomics | csv
NEWS_API_KEY=
NEWS_API_BASE_URL=
NEWS_CSV_PATH=
NEWS_HIGH_BEFORE_MINUTES=15
NEWS_HIGH_AFTER_MINUTES=20
NEWS_BLOCK_MEDIUM=false
NEWS_FAILURE_POLICY=SAFE_MODE

# ---------- Notifications (optional) ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
